      "timing_critical": true,
      "expected_duration_s": 5
    },
    {
      "index": 4,
      "text": "Immediately return the tube to ice for 5 seconds.",
      "default_label": "other",
      "vessel": "ice bucket",
      "timing_critical": true,
      "expected_duration_s": 5
    },
    {
      "index": 5,
      "text": "Spread 50 uL of culture onto an LB agar plate containing the appropriate selective antibiotic.",
      "default_label": "dispense",
      "vessel": "LB agar plate"
    },
    {
